[gd_scene load_steps=2 format=3 uid="uid://bj85j3w8savcn"]

[sub_resource type="GDScript" id="GDScript_aaq88"]
script/source = "extends Control


func _on_line_edit_text_submitted(new_text: String) -> void:
	if new_text.is_empty():
		pass
	else:
		Autoload.player_name = new_text
	Hud.reset_timer()
	Hud.show_timer()
	Hud.unpause_timer()
	Autoload.current_level = 1
	get_tree().change_scene_to_file(\"res://scenes/levels/Hardware.tscn\")
"

