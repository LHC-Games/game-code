[gd_scene load_steps=4 format=3 uid="uid://62hjbvoa1tbj"]

[sub_resource type="GDScript" id="GDScript_fyjtc"]
script/source = "extends CanvasLayer


func _ready() -> void:
	if Autoload.in_software:
		Hud.hide_timer()
		Autoload.in_software = false
		$Level2/MarginContainer/Button2.text = \"Você conseguiu \" + Autoload.player_name + \"!\\n\\nSeu tempo foi: \" + Hud.timer_label.text + \"\\n\\nPressione para continuar...\"
		$Level2.show()
		$Level1.hide()
	else:
		Autoload.in_software = true
		$Level2.hide()
		$Level1.show()


func _on_button_1_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/levels/Software.tscn\")


func _on_button_2_pressed() -> void:
	var p_name = Autoload.player_name
	var p_time = Hud.timer_label.text
	var new_score = {
		\"name\": p_name,
		\"time\": p_time
	}
	Autoload.ranking_data.append(new_score)
	Autoload.save_ranking()
	get_tree().change_scene_to_file(\"res://Main.tscn\")
"

